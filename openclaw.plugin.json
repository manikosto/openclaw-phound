{
  "id": "phound",
  "categories": [
    "channels"
  ],
  "name": "Phound",
  "description": "Phound chats, SMS and phone calls for OpenClaw, through a Phound bot persona.",
  "activation": {
    "onStartup": false
  },
  "channels": [
    "phound"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "contracts": {
    "tools": [
      "phound_call",
      "phound_hangup"
    ]
  },
  "channelConfigs": {
    "phound": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
